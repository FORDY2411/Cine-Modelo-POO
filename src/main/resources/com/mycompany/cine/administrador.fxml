<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.mycompany.cine.controladores.AdministradorController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1e293b; -fx-padding: 12 20 12 20;" BorderPane.alignment="CENTER">
         <children>
            <VBox HBox.hgrow="ALWAYS">
               <children>
                  <Label text="🎬 Sistema de Gestión de Cine - Taquilla" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  <Label text="Módulo DAO: Gestión de Administradores (Actividad 3.8 - MySQL cine_db)" textFill="#94a3b8">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#handleVolverTaquilla" prefHeight="38.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;" text="⬅ Volver a Taquilla (cines.fxml)" />
            <Button mnemonicParsing="false" onAction="#handleSalirLogin" prefHeight="38.0" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;" text="🚪 Salir al Login" />
         </children>
      </HBox>
   </top>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <left>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a202c;" text="Formulario de Administrador" />
            
            <GridPane hgap="10.0" vgap="8.0">
               <children>
                  <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="txtId" editable="false" promptText="Autogenerado" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                  <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="txtNombre" promptText="Nombre completo o nombres" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Label text="Apellidos:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextField fx:id="txtApellidos" promptText="Apellidos (opcional)" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                  <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <TextField fx:id="txtTelefono" promptText="10 dígitos (opcional)" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                  <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                  <TextField fx:id="txtEmail" promptText="correo@cine.com" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                  <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                  <TextField fx:id="txtDireccion" promptText="Calle, número, col." GridPane.columnIndex="1" GridPane.rowIndex="5" />

                  <Label text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                  <TextField fx:id="txtUsuario" promptText="Nombre de usuario" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                  <Label text="Contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                  <TextField fx:id="txtClaveAcceso" promptText="Clave de acceso" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                  <Label text="Rol:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                  <ComboBox fx:id="cmbRol" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="8" />

                  <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="9" />
                  <ComboBox fx:id="cmbEstado" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="9" />

                  <Label text="Foto Perfil:" GridPane.columnIndex="0" GridPane.rowIndex="10" />
                  <HBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="10">
                     <children>
                        <TextField fx:id="txtRutaImagen" editable="false" promptText="Ruta de la imagen" HBox.hgrow="ALWAYS" />
                        <Button onAction="#btnSeleccionarImagenOnAction" text="..." />
                     </children>
                  </HBox>
               </children>
            </GridPane>

            <!-- Previsualización de imagen -->
            <VBox alignment="CENTER" prefHeight="130.0" prefWidth="280.0" style="-fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-background-color: #f7fafc;">
               <children>
                  <ImageView fx:id="imgVistaPrevia" fitHeight="120.0" fitWidth="260.0" pickOnBounds="true" preserveRatio="true" />
               </children>
            </VBox>

            <!-- Botones de Acción CRUD -->
            <HBox spacing="8.0">
               <children>
                  <Button fx:id="btnGuardar" onAction="#btnGuardarOnAction" style="-fx-background-color: #3182ce; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar" />
                  <Button fx:id="btnActualizar" onAction="#btnActualizarOnAction" style="-fx-background-color: #38a169; -fx-text-fill: white; -fx-font-weight: bold;" text="Actualizar" />
                  <Button fx:id="btnEliminar" onAction="#btnEliminarOnAction" style="-fx-background-color: #e53e3e; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar" />
                  <Button fx:id="btnLimpiar" onAction="#btnLimpiarOnAction" style="-fx-background-color: #718096; -fx-text-fill: white; -fx-font-weight: bold;" text="Limpiar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </left>
   
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets left="15.0" />
         </BorderPane.margin>
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a202c;" text="Catálogo de Administradores Registrados (MySQL cine_db)" />
            <TableView fx:id="tblAdministradores" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                  <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
                  <TableColumn fx:id="colEmail" prefWidth="160.0" text="Email" />
                  <TableColumn fx:id="colUsuario" prefWidth="110.0" text="Usuario" />
                  <TableColumn fx:id="colRol" prefWidth="110.0" text="Rol" />
                  <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
                  <TableColumn fx:id="colRutaImagen" prefWidth="160.0" text="Ruta Imagen" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
