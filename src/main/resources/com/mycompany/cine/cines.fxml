                                    <Label text="Turno / Estado:" GridPane.rowIndex="6" />
                                    <ComboBox fx:id="cmbUsuarioTurno" maxWidth="1.7976931348623157E308" promptText="Seleccionar..." GridPane.columnIndex="1" GridPane.rowIndex="6" />
