                                 <children>
                                    <Button mnemonicParsing="false" onAction="#handleNuevoUsuario" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-cursor: hand;" text="Nuevo" />
                                    <Button mnemonicParsing="false" onAction="#handleGuardarUsuario" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Guardar" />
                                    <Button mnemonicParsing="false" onAction="#handleEditarUsuario" style="-fx-background-color: #eab308; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand;" text="Editar" />
                                    <Button mnemonicParsing="false" onAction="#handleEliminarUsuario" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-cursor: hand;" text="Eliminar" />
                                    <Button mnemonicParsing="false" onAction="#handleLimpiarUsuario" style="-fx-background-color: #94a3b8; -fx-text-fill: white; -fx-cursor: hand;" text="Limpiar" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        
                        <!-- Tabla Usuarios -->
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Listado de Personal Registrado" textFill="#1e293b">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS">
                                <columns>
                                  <TableColumn fx:id="colUsuarioId" prefWidth="55.0" text="ID" />
                                  <TableColumn fx:id="colUsuarioNombre" prefWidth="110.0" text="Nombre" />
                                  <TableColumn fx:id="colUsuarioApellido" prefWidth="110.0" text="Apellido" />
                                  <TableColumn fx:id="colUsuarioEmail" prefWidth="140.0" text="Email" />
                                  <TableColumn fx:id="colUsuarioNivel" prefWidth="100.0" text="Nivel Acceso" />
                                  <TableColumn fx:id="colUsuarioTurno" prefWidth="95.0" text="Turno" />
                                </columns>
                              </TableView>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>
